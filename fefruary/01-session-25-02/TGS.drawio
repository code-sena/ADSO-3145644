        <mxCell id="mJWOsMe4MamUwUcD583s-33" value="&lt;font color=&quot;#ffffff&quot;&gt;Corazón, Cerebro, Manos, Piernas, Brazos nos son funcionales, si no trabajan en conjunto.&amp;nbsp;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=light-dark(#003300,#173D4D);strokeColor=#10739e;glass=0;" vertex="1" parent="1">
          <mxGeometry x="660" y="330" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mJWOsMe4MamUwUcD583s-34" value="&lt;font color=&quot;#ffffff&quot;&gt;Es la capacidad que tiene diferentes sistemas para aportar de manera organizada sus fortalezas, y mitigar de sus debilidades para lograr un mismo propósito.&amp;nbsp;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=light-dark(#003300,#173D4D);strokeColor=#10739e;glass=0;" vertex="1" parent="1">
