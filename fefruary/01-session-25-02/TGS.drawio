        <mxCell id="mJWOsMe4MamUwUcD583s-12" value="&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(7, 7, 7);&quot;&gt;Permite la entrada y salida del producto y la materia&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(7, 7, 7);&quot;&gt;Intercambian información&amp;nbsp; con el entorno&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(7, 7, 7);&quot;&gt;Sistema abierto permite la entrada y la salida de datos e información&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;glass=0;fillColor=#1ba1e2;strokeColor=#006EAF;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
