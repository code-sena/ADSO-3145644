        <mxCell id="mJWOsMe4MamUwUcD583s-13" value="&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(21, 21, 21);&quot;&gt;No interactúan con el exterior&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(21, 21, 21);&quot;&gt;Solo muestra informacion ,no recibe&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(21, 21, 21);&quot;&gt;Son los que tienen acceso limitado a datos&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;rounded=1;glass=0;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
